{
  "name": "@tinadec/manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tinadec ecosystem desktop manager",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:browser": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electrobun:build": "vite build && bun scripts/electrobun-cli.ts build --env=stable",
    "electrobun:smoke": "vite build && bun scripts/electrobun-cli.ts build --env=dev"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.16.0",
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/bun": "1.2.21",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "shadcn": "2.6.3",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "^3.2.4"
  }
}
